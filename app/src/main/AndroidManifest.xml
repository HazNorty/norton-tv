<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Norton TV asks for no location: the Wi-Fi pill shows "Connected" instead of the network name. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Recently watched: Android TV's Watch Next list (Netflix, Prime Video…). -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <!-- Trending picks: TMDB lists and backdrops. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Control Center: "Free up memory". -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Hold OK on an app → Uninstall: opens Android's own "Uninstall this app?" dialog. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Control Center → Bluetooth: list paired speakers and connect or disconnect them. Android 12+ asks once
         ("Nearby devices"); before that it comes with the install. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- Android 11+ package visibility: without this the app grid comes up empty. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.media.tv.TvInputService" />
        </intent>
        <!-- The TV's built-in launchers, so the accessibility service can keep Home on Talkies. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.Glass"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="false">

        <!-- Norton TV's home screen: the Control Room dashboard (DashboardActivity). -->
        <activity
            android:name=".DashboardActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|orientation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Also listed as an app, so another launcher (Projectivy) can open it to switch back. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Talkies' screen, now Norton TV's All apps (with its Inputs menu and settings), opened from the dashboard. -->
        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|orientation|uiMode" />

        <!-- The full-screen calendar, opened from the dashboard's calendar tile. -->
        <activity
            android:name=".CalendarActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|orientation|uiMode" />

        <!-- Norton TV has no accessibility service, notification listener or boot receiver (Talkies' sleep timer,
             Turn off now, Restart, remote keys and updates bell are gone with them). -->

        <!-- The UK catch-up players. On this Bravia they're YouView's HbbTV apps, not Play Store apps (those won't
             install on its 32-bit chip): each alias is a tile in the dock and All apps that opens one through Sony's
             HbbTV launcher. See PlayerActivity. -->
        <activity
            android:name=".PlayerActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- taskAffinity "": its own task, or a launch from the home screen just brings the home screen forward. -->
        <activity-alias android:name=".IPlayer" android:targetActivity=".PlayerActivity" android:exported="true"
            android:label="BBC iPlayer" android:banner="@drawable/banner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <meta-data android:name="player" android:value="iplayer" />
            <meta-data android:name="url" android:value="https://www.live.bbctvapps.co.uk/tap/iplayer/" />
            <meta-data android:name="colour" android:value="#E5007D" />
        </activity-alias>
        <activity-alias android:name=".ITVX" android:targetActivity=".PlayerActivity" android:exported="true"
            android:label="ITVX" android:banner="@drawable/banner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <meta-data android:name="player" android:value="itvx" />
            <meta-data android:name="url" android:value="http://app.10ft.itv.com/youviewsony/?dttRegion=GBR-ENG-london-london" />
            <meta-data android:name="colour" android:value="#16364B" />
        </activity-alias>
        <activity-alias android:name=".Channel4" android:targetActivity=".PlayerActivity" android:exported="true"
            android:label="Channel 4" android:banner="@drawable/banner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <meta-data android:name="player" android:value="channel4" />
            <meta-data android:name="url" android:value="https://yvweb.channel4.com/yvwebapp/" />
            <meta-data android:name="colour" android:value="#0F8B8D" />
        </activity-alias>
        <activity-alias android:name=".My5" android:targetActivity=".PlayerActivity" android:exported="true"
            android:label="My5" android:banner="@drawable/banner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <meta-data android:name="player" android:value="my5" />
            <meta-data android:name="url" android:value="https://c5apps.channel5.com/my5youviewsonytv/index.html" />
            <meta-data android:name="colour" android:value="#5B2A86" />
        </activity-alias>
    </application>
</manifest>
