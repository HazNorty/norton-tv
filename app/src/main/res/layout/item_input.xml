<?xml version="1.0" encoding="utf-8"?>
<!-- A row in the Inputs or Control Center menu; colours are set in code per theme. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <TextView
        android:id="@+id/input_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/geist"
        android:fontVariationSettings="'wght' 450"
        android:singleLine="true"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/input_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:fontFamily="@font/geist"
        android:fontVariationSettings="'wght' 400"
        android:singleLine="true"
        android:textSize="14sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/input_dot"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginStart="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/dot" />
</LinearLayout>
