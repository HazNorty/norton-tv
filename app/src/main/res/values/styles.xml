<resources>
    <!-- Round icon buttons, top right. Colours and the focused look are set in code per day/night theme. -->
    <style name="IconButton">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:padding">7dp</item>
        <item name="android:layout_marginStart">7dp</item>
    </style>
    <style name="TabText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/geist</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
